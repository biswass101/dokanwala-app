NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME=dokanwala-api
APP_VERSION=0.1.0
DEFAULT_TIMEZONE=Asia/Dhaka

# PostgreSQL (Docker Compose maps dev DB to port 5433, test DB to port 5434)
DATABASE_URL="postgresql://dokanwala:dokanwala_dev_pass@localhost:5433/dokanwala_dev?schema=public"

# CORS comma-separated allowed origins (leave empty in dev to allow localhost/LAN Expo origins)
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Logging (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
