NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_NAME=dokanwala-api
APP_VERSION=0.1.0
DEFAULT_TIMEZONE=Asia/Dhaka

# PostgreSQL (Docker Compose maps dev DB to port 5433, test DB to port 5434)
DATABASE_URL="postgresql://dokanwala:dokanwala_dev_pass@localhost:5433/dokanwala_dev?schema=public"

# Authentication & JWT (MUST replace with a random >=32 char secret in production)
JWT_ACCESS_SECRET="replace-with-a-random-minimum-32-character-secret-key"
JWT_ACCESS_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_DAYS=30
ALLOW_PUBLIC_REGISTRATION=true
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# CORS comma-separated allowed origins (REQUIRED in production; leave empty in dev for localhost/LAN Expo origins)
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# Set to true when deployed behind Nginx, Cloudflare, Render, Railway, or Fly reverse proxies
TRUST_PROXY=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX=15

# Logging (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
