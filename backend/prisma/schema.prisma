generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  EMPLOYEE
}

enum LanguageCode {
  bn
  en
}

enum DigitStyle {
  bn
  en
}

model SystemMetadata {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_metadata")
}

model Shop {
  id                         String       @id @default(uuid()) @db.Uuid
  nameBn                     String       @map("name_bn") @db.VarChar(150)
  nameEn                     String?      @map("name_en") @db.VarChar(150)
  addressBn                  String?      @map("address_bn") @db.VarChar(300)
  addressEn                  String?      @map("address_en") @db.VarChar(300)
  phone                      String?      @db.VarChar(20)
  logoUrl                    String?      @map("logo_url") @db.VarChar(500)
  currencyCode               String       @default("BDT") @map("currency_code") @db.VarChar(10)
  timezone                   String       @default("Asia/Dhaka") @db.VarChar(60)
  defaultLanguage            LanguageCode @default(bn) @map("default_language")
  defaultDigitStyle          DigitStyle   @default(bn) @map("default_digit_style")
  receiptHeaderBn            String?      @map("receipt_header_bn") @db.VarChar(300)
  receiptFooterBn            String?      @map("receipt_footer_bn") @db.VarChar(300)
  allowNegativeStock         Boolean      @default(false) @map("allow_negative_stock")
  employeeCanGiveCredit      Boolean      @default(true) @map("employee_can_give_credit")
  employeeMaxDiscountPercent Int          @default(10) @map("employee_max_discount_percent")
  isActive                   Boolean      @default(true) @map("is_active")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  users           User[]
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]

  @@map("shops")
}

model User {
  id                  String       @id @default(uuid()) @db.Uuid
  shopId              String       @map("shop_id") @db.Uuid
  name                String       @db.VarChar(120)
  phone               String       @unique @db.VarChar(20)
  role                UserRole     @default(EMPLOYEE)
  passwordHash        String       @map("password_hash") @db.Text
  pinHash             String?      @map("pin_hash") @db.Text
  preferredLanguage   LanguageCode @default(bn) @map("preferred_language")
  preferredDigitStyle DigitStyle   @default(bn) @map("preferred_digit_style")
  failedLoginAttempts Int          @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?    @map("locked_until")
  isActive            Boolean      @default(true) @map("is_active")
  deletedAt           DateTime?    @map("deleted_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  shop            Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  refreshSessions RefreshSession[]
  auditLogs       AuditLog[]

  @@index([shopId, isActive])
  @@map("users")
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  shopId              String    @map("shop_id") @db.Uuid
  tokenFamily         String    @map("token_family") @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.VarChar(128)
  deviceId            String?   @map("device_id") @db.VarChar(120)
  deviceName          String?   @map("device_name") @db.VarChar(120)
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenFamily])
  @@map("refresh_sessions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  deviceId    String?  @map("device_id") @db.VarChar(120)
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.VarChar(80)
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  occurredAt  DateTime @default(now()) @map("occurred_at")

  shop      Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shopId, occurredAt(sort: Desc)])
  @@map("audit_logs")
}
