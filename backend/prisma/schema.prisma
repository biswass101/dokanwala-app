generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  EMPLOYEE
}

enum LanguageCode {
  bn
  en
}

enum DigitStyle {
  bn
  en
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE_IN
  SALE_OUT
  RETURN_IN
  PURCHASE_RETURN_OUT
  COUNT_ADJUST
  WASTAGE_OUT
  DAMAGE_OUT
  EXPIRED_OUT
}

enum StockAdjustmentType {
  COUNT_ADJUST
  WASTAGE
  DAMAGE
  EXPIRED
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  OTHER
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

enum DiscountType {
  FIXED_POISHA
  PERCENT
}

enum RefundMethod {
  CASH
  BKASH
  NAGAD
  OTHER
  CREDIT_ADJUSTMENT
}

enum PurchaseStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
}

enum PurchaseRefundMethod {
  CASH
  BKASH
  NAGAD
  OTHER
  PAYABLE_ADJUSTMENT
}

model SystemMetadata {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_metadata")
}

model Shop {
  id                         String       @id @default(uuid()) @db.Uuid
  nameBn                     String       @map("name_bn") @db.VarChar(150)
  nameEn                     String?      @map("name_en") @db.VarChar(150)
  addressBn                  String?      @map("address_bn") @db.VarChar(300)
  addressEn                  String?      @map("address_en") @db.VarChar(300)
  phone                      String?      @db.VarChar(20)
  logoUrl                    String?      @map("logo_url") @db.VarChar(500)
  currencyCode               String       @default("BDT") @map("currency_code") @db.VarChar(10)
  timezone                   String       @default("Asia/Dhaka") @db.VarChar(60)
  defaultLanguage            LanguageCode @default(bn) @map("default_language")
  defaultDigitStyle          DigitStyle   @default(bn) @map("default_digit_style")
  receiptHeaderBn            String?      @map("receipt_header_bn") @db.VarChar(300)
  receiptFooterBn            String?      @map("receipt_footer_bn") @db.VarChar(300)
  allowNegativeStock         Boolean      @default(false) @map("allow_negative_stock")
  employeeCanGiveCredit      Boolean      @default(true) @map("employee_can_give_credit")
  employeeMaxDiscountPercent Int          @default(10) @map("employee_max_discount_percent")
  isActive                   Boolean      @default(true) @map("is_active")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  users             User[]
  refreshSessions   RefreshSession[]
  auditLogs         AuditLog[]
  categories        Category[]
  units             Unit[]
  products          Product[]
  productUnits      ProductUnit[]
  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  stockAdjustments  StockAdjustment[]
  customers           Customer[]
  sales               Sale[]
  saleItems           SaleItem[]
  payments            Payment[]
  saleReturns         SaleReturn[]
  saleReturnItems     SaleReturnItem[]
  suppliers           Supplier[]
  purchases           Purchase[]
  purchaseItems       PurchaseItem[]
  purchaseReturns     PurchaseReturn[]
  purchaseReturnItems PurchaseReturnItem[]
  supplierPayments    SupplierPayment[]

  @@map("shops")
}

model User {
  id                  String       @id @default(uuid()) @db.Uuid
  shopId              String       @map("shop_id") @db.Uuid
  name                String       @db.VarChar(120)
  phone               String       @unique @db.VarChar(20)
  role                UserRole     @default(EMPLOYEE)
  passwordHash        String       @map("password_hash") @db.Text
  pinHash             String?      @map("pin_hash") @db.Text
  preferredLanguage   LanguageCode @default(bn) @map("preferred_language")
  preferredDigitStyle DigitStyle   @default(bn) @map("preferred_digit_style")
  failedLoginAttempts Int          @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?    @map("locked_until")
  isActive            Boolean      @default(true) @map("is_active")
  deletedAt           DateTime?    @map("deleted_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  shop                Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  refreshSessions     RefreshSession[]
  auditLogs           AuditLog[]
  stockMovements      StockMovement[]
  stockAdjustments    StockAdjustment[]
  salesRecorded           Sale[]            @relation("SaleActorUser")
  salesCancelled          Sale[]            @relation("SaleCancelledByUser")
  saleReturnsRecorded     SaleReturn[]
  purchasesRecorded       Purchase[]        @relation("PurchaseActorUser")
  purchaseReturnsRecorded PurchaseReturn[]
  supplierPayments        SupplierPayment[]

  @@index([shopId, isActive])
  @@map("users")
}

model RefreshSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  shopId              String    @map("shop_id") @db.Uuid
  tokenFamily         String    @map("token_family") @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.VarChar(128)
  deviceId            String?   @map("device_id") @db.VarChar(120)
  deviceName          String?   @map("device_name") @db.VarChar(120)
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenFamily])
  @@map("refresh_sessions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  deviceId    String?  @map("device_id") @db.VarChar(120)
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.VarChar(80)
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  occurredAt  DateTime @default(now()) @map("occurred_at")

  shop      Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shopId, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  shopId    String    @map("shop_id") @db.Uuid
  nameBn    String    @map("name_bn") @db.VarChar(120)
  nameEn    String?   @map("name_en") @db.VarChar(120)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  products Product[]

  @@index([shopId, isActive, deletedAt])
  @@index([shopId, sortOrder])
  @@map("categories")
}

model Unit {
  id           String   @id @default(uuid()) @db.Uuid
  shopId       String   @map("shop_id") @db.Uuid
  code         String   @db.VarChar(30)
  nameBn       String   @map("name_bn") @db.VarChar(60)
  nameEn       String   @map("name_en") @db.VarChar(60)
  isFractional Boolean  @default(false) @map("is_fractional")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shop                        Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  baseUnitProducts            Product[]     @relation("ProductBaseUnit")
  defaultSaleUnitProducts     Product[]     @relation("ProductDefaultSaleUnit")
  defaultPurchaseUnitProducts Product[]     @relation("ProductDefaultPurchaseUnit")
  productUnits                ProductUnit[]
  saleItems                   SaleItem[]
  purchaseItems               PurchaseItem[]

  @@unique([shopId, code])
  @@index([shopId])
  @@map("units")
}

model Product {
  id                      String    @id @default(uuid()) @db.Uuid
  shopId                  String    @map("shop_id") @db.Uuid
  categoryId              String?   @map("category_id") @db.Uuid
  nameBn                  String    @map("name_bn") @db.VarChar(180)
  nameEn                  String?   @map("name_en") @db.VarChar(180)
  barcode                 String?   @db.VarChar(80)
  imageUrl                String?   @map("image_url") @db.VarChar(500)
  defaultSupplierName     String?   @map("default_supplier_name") @db.VarChar(150)
  baseUnitId              String    @map("base_unit_id") @db.Uuid
  defaultSaleUnitId       String    @map("default_sale_unit_id") @db.Uuid
  defaultPurchaseUnitId   String    @map("default_purchase_unit_id") @db.Uuid
  baseSellingPricePoisha  Int       @map("base_selling_price_poisha")
  lastPurchasePricePoisha Int       @default(0) @map("last_purchase_price_poisha")
  lowStockThresholdBase   Decimal   @default(0) @map("low_stock_threshold_base") @db.Decimal(15, 4)
  isActive                Boolean   @default(true) @map("is_active")
  deletedAt               DateTime? @map("deleted_at")
  version                 Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  shop                Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category            Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  baseUnit            Unit              @relation("ProductBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  defaultSaleUnit     Unit              @relation("ProductDefaultSaleUnit", fields: [defaultSaleUnitId], references: [id], onDelete: Restrict)
  defaultPurchaseUnit Unit              @relation("ProductDefaultPurchaseUnit", fields: [defaultPurchaseUnitId], references: [id], onDelete: Restrict)
  productUnits        ProductUnit[]
  inventoryBalance    InventoryBalance?
  stockMovements      StockMovement[]
  stockAdjustments    StockAdjustment[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]

  @@index([shopId, isActive, deletedAt])
  @@index([shopId, categoryId])
  @@index([shopId, barcode])
  @@map("products")
}

model ProductUnit {
  id                     String   @id @default(uuid()) @db.Uuid
  shopId                 String   @map("shop_id") @db.Uuid
  productId              String   @map("product_id") @db.Uuid
  unitId                 String   @map("unit_id") @db.Uuid
  conversionFactorToBase Decimal  @map("conversion_factor_to_base") @db.Decimal(15, 4)
  sellingPricePoisha     Int?     @map("selling_price_poisha")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([productId, unitId])
  @@index([shopId, productId])
  @@map("product_units")
}

model InventoryBalance {
  productId         String   @id @map("product_id") @db.Uuid
  shopId            String   @map("shop_id") @db.Uuid
  qtyBase           Decimal  @default(0) @map("qty_base") @db.Decimal(15, 4)
  avgCostPerBaseBdt Decimal  @default(0) @map("avg_cost_per_base_bdt") @db.Decimal(18, 6)
  version           Int      @default(1)
  updatedAt         DateTime @updatedAt @map("updated_at")

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([shopId])
  @@map("inventory_balances")
}

model StockMovement {
  id               String            @id @default(uuid()) @db.Uuid
  shopId           String            @map("shop_id") @db.Uuid
  productId        String            @map("product_id") @db.Uuid
  movementType     StockMovementType @map("movement_type")
  deltaQtyBase     Decimal           @map("delta_qty_base") @db.Decimal(15, 4)
  balanceAfterBase Decimal           @map("balance_after_base") @db.Decimal(15, 4)
  unitCostBdt      Decimal           @map("unit_cost_bdt") @db.Decimal(18, 6)
  valuePoisha      Int               @map("value_poisha")
  referenceType    String?           @map("reference_type") @db.VarChar(40)
  referenceId      String?           @map("reference_id") @db.VarChar(80)
  reason           String?           @db.VarChar(300)
  actorUserId      String?           @map("actor_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")

  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  actorUser User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shopId, productId, createdAt(sort: Desc)])
  @@index([shopId, movementType, createdAt(sort: Desc)])
  @@map("stock_movements")
}

model StockAdjustment {
  id             String              @id @default(uuid()) @db.Uuid
  shopId         String              @map("shop_id") @db.Uuid
  productId      String              @map("product_id") @db.Uuid
  adjustmentType StockAdjustmentType @map("adjustment_type")
  qtyBase        Decimal             @map("qty_base") @db.Decimal(15, 4)
  deltaQtyBase   Decimal             @map("delta_qty_base") @db.Decimal(15, 4)
  unitCostBdt    Decimal             @map("unit_cost_bdt") @db.Decimal(18, 6)
  lossPoisha     Int                 @map("loss_poisha")
  reason         String?             @db.VarChar(300)
  idempotencyKey String?             @map("idempotency_key") @db.VarChar(120)
  actorUserId    String?             @map("actor_user_id") @db.Uuid
  adjustedAt     DateTime            @default(now()) @map("adjusted_at")

  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  actorUser User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([shopId, idempotencyKey])
  @@index([shopId, productId, adjustedAt(sort: Desc)])
  @@index([shopId, adjustmentType, adjustedAt(sort: Desc)])
  @@map("stock_adjustments")
}

model Customer {
  id                   String    @id @default(uuid()) @db.Uuid
  shopId               String    @map("shop_id") @db.Uuid
  nameBn               String    @map("name_bn") @db.VarChar(150)
  nameEn               String?   @map("name_en") @db.VarChar(150)
  phone                String?   @db.VarChar(20)
  address              String?   @db.VarChar(300)
  note                 String?   @db.VarChar(300)
  totalPurchasedPoisha Int       @default(0) @map("total_purchased_poisha")
  totalPaidPoisha      Int       @default(0) @map("total_paid_poisha")
  duePoisha            Int       @default(0) @map("due_poisha")
  isActive             Boolean   @default(true) @map("is_active")
  deletedAt            DateTime? @map("deleted_at")
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  shop  Shop   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sales Sale[]

  @@index([shopId, isActive, deletedAt])
  @@index([shopId, duePoisha])
  @@index([shopId, phone])
  @@map("customers")
}

model Sale {
  id                   String       @id @default(uuid()) @db.Uuid
  shopId               String       @map("shop_id") @db.Uuid
  receiptNumber        String       @map("receipt_number") @db.VarChar(40)
  customerId           String?      @map("customer_id") @db.Uuid
  customerNameSnapshot String?      @map("customer_name_snapshot") @db.VarChar(150)
  status               SaleStatus   @default(COMPLETED)
  subtotalPoisha       Int          @map("subtotal_poisha")
  discountType         DiscountType @default(FIXED_POISHA) @map("discount_type")
  discountValue        Decimal      @default(0) @map("discount_value") @db.Decimal(10, 2)
  discountPoisha       Int          @default(0) @map("discount_poisha")
  totalPoisha          Int          @map("total_poisha")
  paidPoisha           Int          @default(0) @map("paid_poisha")
  duePoisha            Int          @default(0) @map("due_poisha")
  tenderedPoisha       Int?         @map("tendered_poisha")
  changePoisha         Int          @default(0) @map("change_poisha")
  returnedTotalPoisha  Int          @default(0) @map("returned_total_poisha")
  cashRefundedPoisha   Int          @default(0) @map("cash_refunded_poisha")
  cogsPoisha           Int          @default(0) @map("cogs_poisha")
  note                 String?      @db.VarChar(300)
  idempotencyKey       String?      @map("idempotency_key") @db.VarChar(120)
  cancelIdempotencyKey String?      @map("cancel_idempotency_key") @db.VarChar(120)
  cancelReason         String?      @map("cancel_reason") @db.VarChar(300)
  cancelledAt          DateTime?    @map("cancelled_at")
  cancelledByUserId    String?      @map("cancelled_by_user_id") @db.Uuid
  actorUserId          String?      @map("actor_user_id") @db.Uuid
  soldAt               DateTime     @default(now()) @map("sold_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  shop            Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  actorUser       User?        @relation("SaleActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  cancelledByUser User?        @relation("SaleCancelledByUser", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  items           SaleItem[]
  payments        Payment[]
  returns         SaleReturn[]

  @@unique([shopId, receiptNumber])
  @@unique([shopId, idempotencyKey])
  @@unique([shopId, cancelIdempotencyKey])
  @@index([shopId, soldAt(sort: Desc), status])
  @@index([shopId, customerId, soldAt(sort: Desc)])
  @@map("sales")
}

model SaleItem {
  id                     String   @id @default(uuid()) @db.Uuid
  shopId                 String   @map("shop_id") @db.Uuid
  saleId                 String   @map("sale_id") @db.Uuid
  productId              String   @map("product_id") @db.Uuid
  unitId                 String   @map("unit_id") @db.Uuid
  productNameBn          String   @map("product_name_bn") @db.VarChar(180)
  productNameEn          String?  @map("product_name_en") @db.VarChar(180)
  unitNameBn             String   @map("unit_name_bn") @db.VarChar(60)
  unitNameEn             String   @map("unit_name_en") @db.VarChar(60)
  qtyDisplay             Decimal  @map("qty_display") @db.Decimal(15, 4)
  conversionFactorToBase Decimal  @map("conversion_factor_to_base") @db.Decimal(15, 4)
  qtyBase                Decimal  @map("qty_base") @db.Decimal(15, 4)
  returnedQtyBase        Decimal  @default(0) @map("returned_qty_base") @db.Decimal(15, 4)
  unitSellingPricePoisha Int      @map("unit_selling_price_poisha")
  unitCostAtSaleBdt      Decimal  @map("unit_cost_at_sale_bdt") @db.Decimal(18, 6)
  lineSubtotalPoisha     Int      @map("line_subtotal_poisha")
  lineCogsPoisha         Int      @map("line_cogs_poisha")
  createdAt              DateTime @default(now()) @map("created_at")

  shop        Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit        Unit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([shopId, productId, createdAt])
  @@map("sale_items")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  shopId       String        @map("shop_id") @db.Uuid
  saleId       String        @map("sale_id") @db.Uuid
  method       PaymentMethod
  amountPoisha Int           @map("amount_poisha")
  reference    String?       @db.VarChar(120)
  receivedAt   DateTime      @default(now()) @map("received_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([shopId, receivedAt(sort: Desc), method])
  @@map("payments")
}

model SaleReturn {
  id                       String       @id @default(uuid()) @db.Uuid
  shopId                   String       @map("shop_id") @db.Uuid
  saleId                   String       @map("sale_id") @db.Uuid
  returnNumber             String       @map("return_number") @db.VarChar(40)
  refundMethod             RefundMethod @map("refund_method")
  subtotalPoisha           Int          @map("subtotal_poisha")
  discountAdjustmentPoisha Int          @default(0) @map("discount_adjustment_poisha")
  refundTotalPoisha        Int          @map("refund_total_poisha")
  cashRefundPoisha         Int          @default(0) @map("cash_refund_poisha")
  creditAdjustedPoisha     Int          @default(0) @map("credit_adjusted_poisha")
  reason                   String?      @db.VarChar(300)
  idempotencyKey           String?      @map("idempotency_key") @db.VarChar(120)
  actorUserId              String?      @map("actor_user_id") @db.Uuid
  returnedAt               DateTime     @default(now()) @map("returned_at")

  shop      Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sale      Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  actorUser User?            @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  items     SaleReturnItem[]

  @@unique([shopId, returnNumber])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, saleId, returnedAt(sort: Desc)])
  @@map("sale_returns")
}

model SaleReturnItem {
  id                     String  @id @default(uuid()) @db.Uuid
  shopId                 String  @map("shop_id") @db.Uuid
  saleReturnId           String  @map("sale_return_id") @db.Uuid
  saleItemId             String  @map("sale_item_id") @db.Uuid
  productId              String  @map("product_id") @db.Uuid
  qtyDisplay             Decimal @map("qty_display") @db.Decimal(15, 4)
  qtyBase                Decimal @map("qty_base") @db.Decimal(15, 4)
  unitSellingPricePoisha Int     @map("unit_selling_price_poisha")
  lineRefundPoisha       Int     @map("line_refund_poisha")
  restoredCogsPoisha     Int     @map("restored_cogs_poisha")

  shop       Shop       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Restrict)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleReturnId])
  @@index([saleItemId])
  @@map("sale_return_items")
}

model Supplier {
  id                   String    @id @default(uuid()) @db.Uuid
  shopId               String    @map("shop_id") @db.Uuid
  nameBn               String    @map("name_bn") @db.VarChar(150)
  nameEn               String?   @map("name_en") @db.VarChar(150)
  phone                String?   @db.VarChar(20)
  address              String?   @db.VarChar(300)
  note                 String?   @db.VarChar(300)
  totalPurchasedPoisha Int       @default(0) @map("total_purchased_poisha")
  totalPaidPoisha      Int       @default(0) @map("total_paid_poisha")
  payablePoisha        Int       @default(0) @map("payable_poisha")
  isActive             Boolean   @default(true) @map("is_active")
  deletedAt            DateTime? @map("deleted_at")
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  shop      Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  purchases Purchase[]
  payments  SupplierPayment[]

  @@index([shopId, isActive, deletedAt])
  @@index([shopId, payablePoisha])
  @@index([shopId, phone])
  @@map("suppliers")
}

model Purchase {
  id                   String         @id @default(uuid()) @db.Uuid
  shopId               String         @map("shop_id") @db.Uuid
  purchaseNumber       String         @map("purchase_number") @db.VarChar(40)
  supplierId           String?        @map("supplier_id") @db.Uuid
  supplierNameSnapshot String?        @map("supplier_name_snapshot") @db.VarChar(150)
  status               PurchaseStatus @default(COMPLETED)
  subtotalPoisha       Int            @map("subtotal_poisha")
  discountPoisha       Int            @default(0) @map("discount_poisha")
  totalPoisha          Int            @map("total_poisha")
  paidPoisha           Int            @default(0) @map("paid_poisha")
  settledDuePoisha     Int            @default(0) @map("settled_due_poisha")
  duePoisha            Int            @default(0) @map("due_poisha")
  paymentMethod        PaymentMethod? @map("payment_method")
  paymentReference     String?        @map("payment_reference") @db.VarChar(120)
  returnedTotalPoisha  Int            @default(0) @map("returned_total_poisha")
  cashRefundedPoisha   Int            @default(0) @map("cash_refunded_poisha")
  note                 String?        @db.VarChar(300)
  idempotencyKey       String?        @map("idempotency_key") @db.VarChar(120)
  actorUserId          String?        @map("actor_user_id") @db.Uuid
  purchasedAt          DateTime       @default(now()) @map("purchased_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  shop             Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  actorUser        User?             @relation("PurchaseActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  items            PurchaseItem[]
  returns          PurchaseReturn[]
  supplierPayments SupplierPayment[]

  @@unique([shopId, purchaseNumber])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, purchasedAt(sort: Desc), status])
  @@index([shopId, supplierId, purchasedAt(sort: Desc)])
  @@map("purchases")
}

model PurchaseItem {
  id                     String   @id @default(uuid()) @db.Uuid
  shopId                 String   @map("shop_id") @db.Uuid
  purchaseId             String   @map("purchase_id") @db.Uuid
  productId              String   @map("product_id") @db.Uuid
  unitId                 String   @map("unit_id") @db.Uuid
  productNameBn          String   @map("product_name_bn") @db.VarChar(180)
  productNameEn          String?  @map("product_name_en") @db.VarChar(180)
  unitNameBn             String   @map("unit_name_bn") @db.VarChar(60)
  unitNameEn             String   @map("unit_name_en") @db.VarChar(60)
  lineOrder              Int      @default(0) @map("line_order")
  qtyDisplay             Decimal  @map("qty_display") @db.Decimal(15, 4)
  conversionFactorToBase Decimal  @map("conversion_factor_to_base") @db.Decimal(15, 4)
  qtyBase                Decimal  @map("qty_base") @db.Decimal(15, 4)
  returnedQtyBase        Decimal  @default(0) @map("returned_qty_base") @db.Decimal(15, 4)
  unitCostPoisha         Int      @map("unit_cost_poisha")
  lineTotalPoisha        Int      @map("line_total_poisha")
  netCostPoisha          Int      @map("net_cost_poisha")
  createdAt              DateTime @default(now()) @map("created_at")

  shop        Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  purchase    Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  product     Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit        Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  returnItems PurchaseReturnItem[]

  @@index([purchaseId, lineOrder])
  @@index([shopId, productId, createdAt])
  @@map("purchase_items")
}

model PurchaseReturn {
  id                       String               @id @default(uuid()) @db.Uuid
  shopId                   String               @map("shop_id") @db.Uuid
  purchaseId               String               @map("purchase_id") @db.Uuid
  returnNumber             String               @map("return_number") @db.VarChar(40)
  refundMethod             PurchaseRefundMethod @map("refund_method")
  subtotalPoisha           Int                  @map("subtotal_poisha")
  discountAdjustmentPoisha Int                  @default(0) @map("discount_adjustment_poisha")
  refundTotalPoisha        Int                  @map("refund_total_poisha")
  cashRefundPoisha         Int                  @default(0) @map("cash_refund_poisha")
  payableAdjustedPoisha    Int                  @default(0) @map("payable_adjusted_poisha")
  reason                   String?              @db.VarChar(300)
  idempotencyKey           String?              @map("idempotency_key") @db.VarChar(120)
  actorUserId              String?              @map("actor_user_id") @db.Uuid
  returnedAt               DateTime             @default(now()) @map("returned_at")

  shop      Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  purchase  Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  actorUser User?                @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  items     PurchaseReturnItem[]

  @@unique([shopId, returnNumber])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, purchaseId, returnedAt(sort: Desc)])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id                 String  @id @default(uuid()) @db.Uuid
  shopId             String  @map("shop_id") @db.Uuid
  purchaseReturnId   String  @map("purchase_return_id") @db.Uuid
  purchaseItemId     String  @map("purchase_item_id") @db.Uuid
  productId          String  @map("product_id") @db.Uuid
  qtyDisplay         Decimal @map("qty_display") @db.Decimal(15, 4)
  qtyBase            Decimal @map("qty_base") @db.Decimal(15, 4)
  unitCostPoisha     Int     @map("unit_cost_poisha")
  lineRefundPoisha   Int     @map("line_refund_poisha")
  reversedCostPoisha Int     @map("reversed_cost_poisha")

  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Restrict)
  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Restrict)
  purchaseItem   PurchaseItem   @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseReturnId])
  @@index([purchaseItemId])
  @@map("purchase_return_items")
}

model SupplierPayment {
  id             String        @id @default(uuid()) @db.Uuid
  shopId         String        @map("shop_id") @db.Uuid
  supplierId     String        @map("supplier_id") @db.Uuid
  purchaseId     String?       @map("purchase_id") @db.Uuid
  method         PaymentMethod
  amountPoisha   Int           @map("amount_poisha")
  reference      String?       @db.VarChar(120)
  note           String?       @db.VarChar(300)
  idempotencyKey String?       @map("idempotency_key") @db.VarChar(120)
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  paidAt         DateTime      @default(now()) @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  supplier  Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase  Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  actorUser User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([shopId, idempotencyKey])
  @@index([shopId, supplierId, paidAt(sort: Desc)])
  @@index([shopId, paidAt(sort: Desc), method])
  @@map("supplier_payments")
}
